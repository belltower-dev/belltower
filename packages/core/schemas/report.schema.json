{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "belltower.report/1",
  "title": "Belltower monthly availability report",
  "description": "public/reports/{yyyy}-{mm}.json, with the same figures as CSV beside it. Compatible within a major version: fields are only added.",
  "type": "object",
  "required": ["format", "month", "writtenAt", "complete", "components"],
  "properties": {
    "format": { "const": "belltower.report/1" },
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "writtenAt": { "type": "string", "format": "date-time" },
    "complete": { "type": "boolean", "description": "False while the month is still running." },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "target", "minutesCounted", "downMinutes", "maintenanceMinutes", "availability", "targetMet", "credit", "incidents", "meanMinutesToRecover"],
        "properties": {
          "name": { "type": "string" },
          "target": { "type": ["number", "null"] },
          "minutesCounted": { "type": "integer", "minimum": 0, "description": "Minutes in the month so far, from when monitoring began, without maintenance." },
          "downMinutes": { "type": "integer", "minimum": 0 },
          "maintenanceMinutes": { "type": "integer", "minimum": 0 },
          "availability": { "type": ["number", "null"], "description": "Percent up, rounded down to three places." },
          "targetMet": { "type": ["boolean", "null"], "description": "Null without a target." },
          "credit": { "type": "number", "minimum": 0, "description": "Percent credit owed by the configured tiers." },
          "incidents": { "type": "integer", "minimum": 0 },
          "meanMinutesToRecover": { "type": ["integer", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
